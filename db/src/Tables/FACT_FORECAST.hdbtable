COLUMN TABLE "training.Tables::FACT_FORECAST" (
 DATE_KEY INTEGER, CUSTOMER_KEY NVARCHAR(20), PRODUCT_KEY NVARCHAR(20),
 LOCATION_KEY NVARCHAR(20), SALES_ORG_KEY NVARCHAR(20),
 SCENARIO_KEY NVARCHAR(20), KPI_KEY NVARCHAR(20), SOURCE_KEY NVARCHAR(20),
 ACTUAL_QTY DECIMAL(18,3), ACTUAL_AMT DECIMAL(18,2),
 FORECAST_QTY DECIMAL(18,3), FORECAST_AMT DECIMAL(18,2),
    PRIMARY KEY(DATE_KEY,CUSTOMER_KEY,PRODUCT_KEY,LOCATION_KEY,SALES_ORG_KEY,SCENARIO_KEY,KPI_KEY,SOURCE_KEY)
)
PARTITION BY HASH (DATE_KEY) PARTITIONS 8