COLUMN TABLE "training.Tables::FACT_ADJUSTMENTS" (
    DATE_KEY INTEGER,
    CUSTOMER_KEY NVARCHAR(20),
    PRODUCT_KEY NVARCHAR(20),
    LOCATION_KEY NVARCHAR(20),
    SALES_ORG_KEY NVARCHAR(20),
    SCENARIO_KEY NVARCHAR(20),
    KPI_KEY NVARCHAR(20),
    SOURCE_KEY NVARCHAR(20),
    ADJUSTMENT_QTY DECIMAL(18,3),
    ADJUSTMENT_AMT DECIMAL(18,2)
)