PROCEDURE "training.SP::SP_TEST_SCALAR"
(
    IN IT_SALES TABLE
    (
        DATE_KEY        INTEGER,
        CUSTOMER_KEY    NVARCHAR(20),
        PRODUCT_KEY     NVARCHAR(20),
        LOCATION_KEY    NVARCHAR(20),
        SALES_ORG_KEY   NVARCHAR(20),
        SCENARIO_KEY    NVARCHAR(20),
        KPI_KEY         NVARCHAR(20),
        SOURCE_KEY      NVARCHAR(20),
        SALES_QTY       DECIMAL(18,3),
        SALES_AMT       DECIMAL(18,2),
         ACTUAL_QTY DECIMAL(18,3), 
        ACTUAL_AMT DECIMAL(18,2),
        FORECAST_QTY DECIMAL(18,3), 
        FORECAST_AMT DECIMAL(18,2)
    ),
    IN I_LOCATION NVARCHAR(20),
    OUT ET_RESULT TABLE
    (
        DATE_KEY        INTEGER,
        CUSTOMER_KEY    NVARCHAR(20),
        PRODUCT_KEY     NVARCHAR(20),
        LOCATION_KEY    NVARCHAR(20),
        SALES_ORG_KEY   NVARCHAR(20),
        SCENARIO_KEY    NVARCHAR(20),
        KPI_KEY         NVARCHAR(20),
        SOURCE_KEY      NVARCHAR(20),
        SALES_QTY       DECIMAL(18,3),
        SALES_AMT       DECIMAL(18,2),
         ACTUAL_QTY DECIMAL(18,3), 
        ACTUAL_AMT DECIMAL(18,2),
        FORECAST_QTY DECIMAL(18,3), 
        FORECAST_AMT DECIMAL(18,2)
    )
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
READS SQL DATA
AS
BEGIN

    ET_RESULT =
        SELECT *
        FROM :IT_SALES
        WHERE LOCATION_KEY = :I_LOCATION;

END;