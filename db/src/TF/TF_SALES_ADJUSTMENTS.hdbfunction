FUNCTION "training.TF::TF_SALES_ADJUSTMENTS" (
)
RETURNS TABLE (
    DATE_KEY             INTEGER,
    CUSTOMER_KEY         NVARCHAR(20),
    PRODUCT_KEY          NVARCHAR(20),
    LOCATION_KEY         NVARCHAR(20),
    SALES_ORG_KEY        NVARCHAR(20),
    SCENARIO_KEY         NVARCHAR(20),
    KPI_KEY              NVARCHAR(20),
    SOURCE_KEY           NVARCHAR(20),
    SALES_QTY            DECIMAL(18,3),
    SALES_AMT            DECIMAL(18,2),
    ADJUSTMENT_QTY       DECIMAL(18,3),
    ADJUSTMENT_AMT       DECIMAL(18,2),
    NET_QTY              DECIMAL(18,3),
    NET_AMT              DECIMAL(18,10)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
READS SQL DATA
AS

BEGIN
    
    RETURN
    
    SELECT
        S.DATE_KEY,
        S.CUSTOMER_KEY,
        S.PRODUCT_KEY,
        S.LOCATION_KEY,
        S.SALES_ORG_KEY,
        S.SCENARIO_KEY,
        S.KPI_KEY,
        S.SOURCE_KEY,

        S.SALES_QTY,
        S.SALES_AMT,

        COALESCE(A.ADJUSTMENT_QTY, 0) AS ADJUSTMENT_QTY,
        COALESCE(A.ADJUSTMENT_AMT, 0) AS ADJUSTMENT_AMT,

        S.SALES_QTY + COALESCE(A.ADJUSTMENT_QTY, 0) AS NET_QTY,
        S.SALES_AMT + COALESCE(A.ADJUSTMENT_AMT, 0) AS NET_AMT

    FROM "training.Tables::FACT_SALES" AS S

    LEFT OUTER JOIN "training.Tables::FACT_ADJUSTMENTS" AS A
      ON  S.DATE_KEY       = A.DATE_KEY
      AND S.CUSTOMER_KEY   = A.CUSTOMER_KEY
      AND S.PRODUCT_KEY    = A.PRODUCT_KEY
      AND S.LOCATION_KEY   = A.LOCATION_KEY
      AND S.SALES_ORG_KEY  = A.SALES_ORG_KEY
      AND S.SCENARIO_KEY   = A.SCENARIO_KEY
      AND S.KPI_KEY        = A.KPI_KEY
      AND S.SOURCE_KEY     = A.SOURCE_KEY;


END;
